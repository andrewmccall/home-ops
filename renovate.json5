{
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    "docker:enableMajor",
    ":enablePreCommit",
  ],
  "timezone": "Europe/London",
  "semanticCommits": "enabled",
  "separateMinorPatch": true,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "suppressNotifications": ["prIgnoreNotification"],
  "kubernetes": {
    "managerFilePatterns": ["/cluster/.+\\.ya?ml$/"],
    "ignorePaths": ["cluster/flux/"]
  },
  "flux": {
    "managerFilePatterns": ["/cluster/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/cluster/.+\\.ya?ml$/"]
  },
  "customManagers": [
    // generic matcher
    // see https://regex101.com/r/fzaLfV/1
    {
      "customType": "regex",
      "managerFilePatterns": ["/ansible/.+\\.ya?ml$/", "/cluster/.+\\.ya?ml$/", "/charts/.+\\.ya?ml$/"],
      "matchStrings": [
        "datasource=(?<datasource>helm) registryUrl=(?<registryUrl>\\S+) chart=(?<depName>\\S+)\n.*?\"?(?<currentValue>[^-\\s]*?)\"?\n",
        "datasource=(?<datasource>docker) image=(?<depName>\\S+)\n.*?\"?(?<currentValue>[^-\\s]*?)\"?\n",
        "datasource=(?<datasource>github-releases) repos=(?<depName>\\S+)\n.*?\"?(?<currentValue>[^-\\s]*?)\"?\n",
        "datasource=(?<datasource>pypi) package=(?<depName>\\S+)\n.*?\"?(?<currentValue>[^-\\s]*?)\"?\n",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?\"?(?<currentValue>[^-\\s]*?)\"?\n",
      ],
      "datasourceTemplate": "{{datasource}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}{{#if (containsString datasource 'pypi')}}pep440{{else}}semver{{/if}}{{/if}}"
    }
  ],
  "customDatasources": {
    // Mojang's download API, which the bedrock image itself queries for LATEST.
    "minecraft-bedrock": {
      "defaultRegistryUrlTemplate": "https://net.web.minecraft-services.net/api/v1.0/download/links",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $match(result.links[downloadType=\"serverBedrockLinux\"].downloadUrl, /bedrock-server-([0-9.]+)\\.zip$/).groups[0]}]}"
      ]
    }
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    // Longhorn only upgrades from the previous minor version and its pre-upgrade
    // check fails otherwise: one PR per minor, merged by hand after the previous one is healthy.
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": ["longhorn"],
      "separateMultipleMinor": true
    },
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": ["longhorn"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    // datasource specific settings
    // Clients auto-update, so the server has to follow every release. Rollout gates
    // and rollback apply as for any image; worlds a newer server has opened may not
    // load on the older one, so a rollback is a stopgap.
    {
      "matchDatasources": ["custom.minecraft-bedrock"],
      "automerge": true
    },
    {
      "matchDatasources": ["helm"],
      "addLabels": ["renovate/helm"]
    },
    {
      "matchDatasources": ["docker"],
      "addLabels": ["renovate/docker"]
    },
    // manager specific settings
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["renovate/github-actions"]
    },
    {
      "matchManagers": ["pip_requirements"],
      "addLabels": ["renovate/python"]
    },
    {
      "matchManagers": ["ansible"],
      "addLabels": ["renovate/ansible"]
    },
    {
      "matchManagers": ["ansible-galaxy"],
      "addLabels": ["renovate/ansible-galaxy"]
    },
    {
      "matchManagers": ["pre-commit"],
      "addLabels": ["renovate/pre-commit"]
    },
    // update types specific settings
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["dependency/major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["dependency/minor"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["dependency/patch"]
    },
    // group snapshot-controller
    {
      "matchDatasources": ["github-releases", "docker"],
      "matchPackageNames": [
        "/external-snapshotter/",
        "/snapshot-controller/"
      ],
      "groupName": "external-snapshotter",
      "additionalBranchPrefix": "",
    },
  ]
}
