{
  extends: [
    'config:best-practices',
    ':disableRateLimiting',
    'docker:enableMajor',
    ':enablePreCommit',
  ],
  timezone: 'Europe/London',
  semanticCommits: 'enabled',
  separateMinorPatch: true,
  dependencyDashboard: {
    enabled: true,
    title: 'Renovate Dashboard',
  },
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  automergeSchedule: [
    '* 0-5 * * *',
  ],
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  kubernetes: {
    managerFilePatterns: [
      '/cluster/.+\\.ya?ml$/',
    ],
    ignorePaths: [
      'cluster/flux/',
    ],
  },
  flux: {
    managerFilePatterns: [
      '/cluster/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/cluster/.+\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/ansible/.+\\.ya?ml$/',
        '/cluster/.+\\.ya?ml$/',
        '/charts/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>helm) registryUrl=(?<registryUrl>\\S+) chart=(?<depName>\\S+)\n.*?"?(?<currentValue>[^-\\s]*?)"?\n',
        'datasource=(?<datasource>docker) image=(?<depName>\\S+)\n.*?"?(?<currentValue>[^-\\s]*?)"?\n',
        'datasource=(?<datasource>github-releases) repos=(?<depName>\\S+)\n.*?"?(?<currentValue>[^-\\s]*?)"?\n',
        'datasource=(?<datasource>pypi) package=(?<depName>\\S+)\n.*?"?(?<currentValue>[^-\\s]*?)"?\n',
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?"?(?<currentValue>[^-\\s]*?)"?\n',
      ],
      datasourceTemplate: '{{datasource}}',
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}{{#if (containsString datasource 'pypi')}}pep440{{else}}semver{{/if}}{{/if}}",
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/cluster/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate-image-digest: depName=(?<depName>\\S+)\\n\\s*tag: "?(?<currentValue>[^\\s"@]+)"?\\n\\s*digest: "?(?<currentDigest>sha256:[a-f0-9]{64})"?',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],
  customDatasources: {
    'minecraft-bedrock': {
      defaultRegistryUrlTemplate: 'https://net.web.minecraft-services.net/api/v1.0/download/links',
      format: 'json',
      transformTemplates: [
        '{"releases": [{"version": $match(result.links[downloadType="serverBedrockLinux"].downloadUrl, /bedrock-server-([0-9.]+)\\.zip$/).groups[0]}]}',
      ],
    },
  },
  packageRules: [
    {
      matchManagers: [
        'helm-values',
      ],
      matchPackageNames: [
        'timberio/vector',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'longhorn',
      ],
      separateMultipleMinor: true,
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'longhorn',
      ],
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      automerge: false,
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchPackageNames: [
        'cloudnative-pg',
      ],
      separateMultipleMinor: true,
      automerge: false,
    },
    {
      matchPackageNames: [
        'k3s-io/k3s',
      ],
      groupName: 'k3s',
      separateMinorPatch: true,
    },
    {
      matchPackageNames: [
        'k3s-io/k3s',
      ],
      matchUpdateTypes: [
        'minor',
        'major',
      ],
      automerge: false,
    },
    {
      matchPackageNames: [
        '/system-upgrade-controller/',
      ],
      groupName: 'system-upgrade-controller',
    },
    {
      matchPackageNames: [
        '/authentik/',
      ],
      groupName: 'authentik',
    },
    {
      matchPackageNames: [
        '/envoyproxy/gateway/',
      ],
      groupName: 'envoy-gateway',
    },
    {
      matchDatasources: [
        'custom.minecraft-bedrock',
      ],
      automerge: true,
      minimumReleaseAge: null,
      automergeSchedule: [
        'at any time',
      ],
    },
    {
      matchUpdateTypes: [
        'pinDigest',
      ],
      minimumReleaseAge: null,
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/music-assistant/server',
        'ghcr.io/home-operations/external-dns-unifi-webhook',
        'registry.k8s.io/agent-sandbox/agent-sandbox-controller',
        'homeassistant/home-assistant',
        'esphome/esphome',
        'codercom/code-server',
      ],
      minimumReleaseAgeBehaviour: 'timestamp-optional',
      automergeSchedule: [
        '* 0-5 * * 0',
      ],
    },
    {
      matchPackageNames: [
        '/^ghcr\\.io/andrewmccall//',
      ],
      minimumReleaseAge: null,
    },
    {
      matchRegistryUrls: [
        'https://home-ops.andrewmccall.com/charts/stable',
      ],
      minimumReleaseAge: null,
    },
    {
      matchDatasources: [
        'helm',
      ],
      addLabels: [
        'renovate/helm',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      addLabels: [
        'renovate/docker',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      addLabels: [
        'renovate/github-actions',
      ],
    },
    {
      matchManagers: [
        'pip_requirements',
      ],
      addLabels: [
        'renovate/python',
      ],
    },
    {
      matchManagers: [
        'ansible',
      ],
      addLabels: [
        'renovate/ansible',
      ],
    },
    {
      matchManagers: [
        'ansible-galaxy',
      ],
      addLabels: [
        'renovate/ansible-galaxy',
      ],
    },
    {
      matchManagers: [
        'pre-commit',
      ],
      addLabels: [
        'renovate/pre-commit',
      ],
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'dependency/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'dependency/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'dependency/patch',
      ],
    },
    {
      matchDatasources: [
        'github-releases',
        'docker',
      ],
      matchPackageNames: [
        '/external-snapshotter/',
        '/snapshot-controller/',
      ],
      groupName: 'external-snapshotter',
      additionalBranchPrefix: '',
    },
  ],
}
