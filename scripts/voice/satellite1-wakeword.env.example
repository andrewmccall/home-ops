# Copy to scripts/voice/satellite1-wakeword.env and adjust as needed.

# Checked-out upstream repos live outside git in a local cache directory.
# On macOS, the helper defaults to ~/Library/Caches/home-ops when unset.
# SATELLITE1_CACHE_ROOT=

# Upstream refs to use when cloning.
SATELLITE1_FIRMWARE_REF=develop
SATELLITE1_MICRO_WAKE_WORD_REF=main

# Python used for the local microWakeWord environment.
# Python 3.10 is recommended by OHF-Voice/micro-wake-word.
# SATELLITE1_TRAINING_PYTHON=python3.10

# Optional default upload target. Leave unset to prefer auto-detected USB serial.
# SATELLITE1_UPLOAD_DEVICE=/dev/cu.usbmodem12345

# Optional default OTA/device host for later uploads/logs.
# SATELLITE1_UPLOAD_HOST=satellite1.local

# Manifest defaults used by the `manifest` subcommand.
SATELLITE1_MODEL_AUTHOR=Andrew McCall
SATELLITE1_MODEL_WEBSITE=https://github.com/andrewmccall/home-ops
SATELLITE1_MODEL_LANGUAGES=en
SATELLITE1_MODEL_MINIMUM_ESPHOME_VERSION=2026.2.0

# Initial wake-word defaults. Tune these after evaluating your trained models.
SATELLITE1_ADA_PROBABILITY_CUTOFF=0.85
SATELLITE1_ADA_SLIDING_WINDOW_SIZE=5
SATELLITE1_ADA_TENSOR_ARENA_SIZE=45672

SATELLITE1_HEY_ADA_PROBABILITY_CUTOFF=0.90
SATELLITE1_HEY_ADA_SLIDING_WINDOW_SIZE=5
SATELLITE1_HEY_ADA_TENSOR_ARENA_SIZE=45672
